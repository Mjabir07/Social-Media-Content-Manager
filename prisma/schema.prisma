// MediaChat — Prisma schema (see CLAUDE.md "Prisma model")
//
// Runs on PostgreSQL (Neon). For portability the schema keeps a couple of
// deliberate simplifications that also worked on the original SQLite dev DB:
//   - enum-like fields (role, asset type, source, chat role) are stored as
//     String and validated in application code (see src/lib/enums.ts).
//   - JSON-ish fields (tags, attachments, snapshots, artifacts) are stored as
//     String holding JSON — use the helpers in src/lib/json.ts to (de)serialize.
//   - the asset<->channel many-to-many uses the explicit AssetChannel join
//     table (already required by the spec) instead of an array column.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime queries use the pooled connection (DATABASE_URL). Schema migrations
  // (prisma migrate deploy) MUST use a direct, non-pooled connection — pgbouncer
  // can't hold the advisory lock migrate needs (Neon "-pooler" host → P1002).
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  passwordHash      String
  avatarColor       String    @default("#0e9f8f")
  createdAt         DateTime  @default(now())
  // Bumped on password reset/change to invalidate older JWT sessions.
  passwordChangedAt DateTime  @default(now())
  // Set when an admin deactivates the account — login + active sessions blocked.
  disabledAt        DateTime?

  memberships   Membership[]
  person        Person[]
  createdAssets MediaAsset[]         @relation("AssetCreatedBy")
  assetVersions AssetVersion[]
  chatSessions  ChatSession[]
  skillUpdates  Skill[]
  resetTokens   PasswordResetToken[]
  notifications Notification[]
  agentProfiles AgentProfile[]       @relation("AgentCreatedBy")
  services      Service[]            @relation("ServiceCreatedBy")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  // Cost-rate calculator (freelancer). hourlyRateCents is derived from the inputs
  // and cached so it can prefill work orders: rate = (overhead + payTarget) /
  // (workingHoursPerMonth * billablePercent/100). See lib/rate-catalog.
  currency               String @default("AED")
  monthlyOverheadCents   Int? // business costs: tools, subscriptions, rent…
  monthlyPayTargetCents  Int? // what you want to take home each month
  workingHoursPerMonth   Int? // hours you actually work per month
  billablePercent        Int? // % of worked hours that are billable (utilization)
  hourlyRateCents        Int? // computed hourly cost rate (prefills work orders)

  memberships         Membership[]
  skills              Skill[]
  people              Person[]
  channels            SocialChannel[]
  assets              MediaAsset[]
  sessions            ChatSession[]
  invites             Invite[]
  activity            ActivityLog[]
  notifications       Notification[]
  companies           Company[]
  providerCredentials ProviderCredential[]
  agentProfiles       AgentProfile[]
  services            Service[]
  connections         ChannelConnection[]
  automations         Automation[]
  leads               Lead[]
  partnerships        Partnership[]
  commissionPayments  CommissionPayment[]
  socialPosts         SocialPost[]
  conversations       Conversation[]
  domainRecords       DomainRecord[]
  hostingRecords      HostingRecord[]
  emailServiceRecords EmailServiceRecord[]
  pulseSubscriptions  PulseSubscription[]
  coolifyConnections  CoolifyConnection[]
  tasks               Task[]
  projects            Project[]
  renewals            Renewal[]
  vaultCredentials    VaultCredential[]
  clients             Client[]
  transactions        Transaction[]
  devProjects         DevProject[]
  works               Work[]
}

// A money movement — the finance ledger. type INCOME (client charges) or
// EXPENSE (server, email license, vendor payments like Google). Net profit is
// simply income − expense. Optionally tied to a Client (per-client P&L) and/or a
// Renewal. status: PAID | PENDING. Soft-deleted. amountCents is always positive;
// direction comes from `type`.
model Transaction {
  id          String    @id @default(cuid())
  workspaceId String
  clientId    String?
  renewalId   String?
  type        String // INCOME | EXPENSE
  amountCents Int
  currency    String    @default("AED")
  category    String    @default("OTHER")
  vendor      String? // who paid you / who you paid (e.g. "Google", client name)
  description String?
  date        DateTime
  status      String    @default("PAID") // PAID | PENDING
  method      String? // Cash | Bank | Card | Online
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([workspaceId, type, date, deletedAt])
  @@index([clientId])
}

// A managed client — the hub record. Open one to see everything tied to it:
// vault credentials, service renewals (and later automations, projects). Kept
// lightweight and separate from Company (which is the heavier brand/HQ concept).
// status: ACTIVE | INACTIVE. Soft-deleted (deletedAt).
model Client {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  type        String    @default("DIRECT") // DIRECT | RESELLER — a reseller holds many works for different end-customers
  domain      String? // primary domain — you often recall a client by this
  contactName String?
  email       String?
  phone       String?
  notes       String?
  status      String    @default("ACTIVE")
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  vaultCredentials VaultCredential[]
  renewals         Renewal[]
  transactions     Transaction[]
  works            Work[]

  @@index([workspaceId, status, deletedAt])
}

// A piece of work / service delivered under a Client. For a reseller client each
// work can name its own end-customer (free text) — the company the work is really
// for — while the bill still goes to the parent client. status: LEAD | ACTIVE |
// DELIVERED | CLOSED. Soft-deleted.
model Work {
  id          String    @id @default(cuid())
  workspaceId String
  clientId    String
  title          String
  serviceType    String? // e.g. "Website", "SEO", "Google Workspace setup"
  endCustomer    String? // reseller's end-company this work is for (free text)
  quantity       Int       @default(1) // units / seats / licenses
  unitPriceCents Int? // price per unit (what you charge); amountCents = quantity * unitPriceCents
  amountCents    Int? // computed revenue total (kept for fast reads + finance sync)
  unitCostCents    Int? // cost per unit (what you pay the vendor); vendor cost = quantity * unitCostCents
  laborHours       Float? // your time on this work
  hourlyRateCents  Int? // your rate; labor cost = laborHours * hourlyRateCents
  operationalCents Int? // operational overhead
  hostingCents     Int? // hosting / infra cost
  costCents        Int? // computed grand total = vendor + labor + operational + hosting → profit = amountCents - costCents
  currency       String    @default("AED")
  status         String    @default("ACTIVE")
  invoiceTxnId   String? // linked auto-synced Finance income line (PENDING)
  costTxnId      String? // linked auto-synced Finance expense line (PENDING)
  startDate      DateTime?
  notes          String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([workspaceId, clientId, deletedAt])
}

// A client credential kept safely for future use (domain panel, email logins,
// hosting/cPanel, social, …). The secret is AES-256-GCM encrypted at rest with
// the app master key (same crypto as the API Vault); the browser only ever gets
// a masked hint until an OWNER/ADMIN explicitly reveals it (audit-logged).
// Grouped by free-text clientName — no Company record required.
// category: DOMAIN | EMAIL | HOSTING | CPANEL | FTP | SOCIAL | OTHER
model VaultCredential {
  id             String    @id @default(cuid())
  workspaceId    String
  clientId       String? // link to the Client hub record
  renewalId      String? // optional link to a Renewal
  clientName     String
  category       String    @default("OTHER")
  label          String // e.g. "GoDaddy domain panel" or "info@domain.com"
  username       String? // login id / email — searchable, NOT the secret
  url            String? // panel / login URL
  encryptedValue String? // the encrypted secret (password / API key)
  iv             String?
  authTag        String?
  keyVersion     Int       @default(1)
  maskedHint     String? // e.g. "••••••••ab12" for display without decrypt
  notes          String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([workspaceId, clientName, deletedAt])
  @@index([clientId])
}

// A standalone service renewal you manage for a client (e.g. Google Workspace
// yearly license) — NOT tied to a Company. Drives the invoice + reminder ladder:
// invoice at -30d, nudges at -15d / -7d, final at -1d (see renewals-core).
// status: ACTIVE | RENEWED | CANCELLED. Soft-deleted (deletedAt).
model Renewal {
  id          String    @id @default(cuid())
  workspaceId String
  clientId    String? // link to the Client hub record
  service     String // e.g. "Google Workspace"
  clientName  String // denormalized label (also works standalone)
  clientEmail String?
  amountCents Int? // what you CHARGE the client (income)
  costCents   Int? // what you PAY the vendor (expense) — enables profit auto-calc
  vendor      String? // who you pay, e.g. "Google"
  currency    String    @default("AED")
  renewalDate DateTime
  status      String    @default("ACTIVE")
  // Billing lifecycle within the current cycle: NONE (nothing raised) -> RAISED
  // (invoice created, income booked PENDING) -> SENT (emailed to client) ->
  // payment received resets it to NONE and rolls renewalDate +1yr.
  invoiceStatus String   @default("NONE") // NONE | RAISED | SENT
  invoicedAt    DateTime? // when the invoice was raised this cycle
  paidAt        DateTime? // when the last cycle's payment was received
  incomeTxnId   String?   // the income Transaction booked for the open invoice
  notes       String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, deletedAt])
  @@index([clientId])
}

// A client/internal project. Workspace-scoped, optionally tied to a Company
// (client). Tasks belong to 0-or-1 project; progress = done/total of its tasks.
// status: PLANNING | ACTIVE | ON_HOLD | DONE. Soft-deleted (deletedAt).
model Project {
  id          String    @id @default(cuid())
  workspaceId String
  companyId   String?
  createdById String?
  ownerId     String?
  name        String
  description String?
  status      String    @default("ACTIVE")
  deadline    DateTime?
  budgetCents Int?
  currency    String    @default("AED")
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  tasks     Task[]

  @@index([workspaceId, status, deletedAt])
}

// A personal / team to-do item. Workspace-scoped. status: TODO | PENDING | DONE
// (PENDING = waiting on someone/something). priority: LOW | MEDIUM | HIGH.
// Soft-deleted (deletedAt) per the data-safety rule.
model Task {
  id          String    @id @default(cuid())
  workspaceId String
  companyId   String?
  projectId   String?
  createdById String?
  assigneeId  String?
  title       String
  notes       String?
  status      String    @default("TODO")
  priority    String    @default("MEDIUM")
  dueDate     DateTime?
  order       Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, deletedAt])
  @@index([projectId])
}

// A live connection to a self-hosted Coolify instance (your VPS). The API token
// is encrypted with the app master key like the vault; the browser never sees
// it. status: CONNECTED | ERROR | DISCONNECTED
model CoolifyConnection {
  id             String    @id @default(cuid())
  workspaceId    String
  name           String
  baseUrl        String
  encryptedToken String?
  iv             String?
  authTag        String?
  keyVersion     Int       @default(1)
  status         String    @default("DISCONNECTED")
  lastError      String?
  lastCheckedAt  DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// Workspace-scoped API credential. The raw secret is encrypted by the app with
// an environment-held master key and is never returned to the browser.
model ProviderCredential {
  id              String    @id @default(cuid())
  workspaceId     String
  provider        String
  encryptedValue  String
  iv              String
  authTag         String
  keyVersion      Int       @default(1)
  maskedValue     String
  status          String    @default("ACTIVE")
  lastTestedAt    DateTime?
  lastTestStatus  String?
  lastTestMessage String?
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
  @@index([workspaceId, status])
}

// A separately managed business identity inside one tenant/workspace.
// relationshipType: OWN_BRAND | CLIENT | PARTNER | JOINT_VENTURE
// status: ACTIVE | PAUSED | ARCHIVED
model Company {
  id               String   @id @default(cuid())
  workspaceId      String
  name             String
  slug             String
  relationshipType String
  industry         String?
  website          String?
  description      String?
  status           String   @default("ACTIVE")
  isHeadquarters   Boolean  @default(false)
  primaryColor     String   @default("#087CFA")
  accentColor      String   @default("#22D3EE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brandProfile        BrandProfile?
  brain               CompanyBrain?
  agents              AgentProfile[]
  services            Service[]
  connections         ChannelConnection[]
  automations         Automation[]
  leads               Lead[]
  partnerships        Partnership[]        @relation("PartnerOf")
  socialPosts         SocialPost[]
  conversations       Conversation[]
  domainRecords       DomainRecord[]
  hostingRecords      HostingRecord[]
  emailServiceRecords EmailServiceRecord[]
  pulseSubscriptions  PulseSubscription[]
  tasks               Task[]
  projects            Project[]
  devProjects         DevProject[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, status])
}

model BrandProfile {
  id              String   @id @default(cuid())
  companyId       String   @unique
  tagline         String?
  brandVoice      String?
  targetAudiences String   @default("[]")
  offerings       String   @default("[]")
  differentiators String   @default("[]")
  contentRules    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model CompanyBrain {
  id              String   @id @default(cuid())
  companyId       String   @unique
  companyFacts    String?
  salesGuidance   String?
  contentGuidance String?
  aiInstructions  String?
  knowledgeStatus String   @default("EMPTY")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// A named, company-scoped AI operator. Its effective runtime system prompt is
// composed from the company Brand Profile + Company Brain + this profile's own
// instructions (see src/lib/agents.ts), so an agent can never carry another
// company's context. `autonomy` is the automation dial: how far it may act
// before a human approves (SUGGEST | DRAFT | AUTOPILOT).
model AgentProfile {
  id           String   @id @default(cuid())
  workspaceId  String
  companyId    String
  name         String
  role         String
  systemPrompt String
  providerId   String? // preferred vault provider (ProviderCredential.provider); null -> router default
  autonomy     String   @default("SUGGEST") // SUGGEST | DRAFT | AUTOPILOT
  status       String   @default("ACTIVE") // ACTIVE | DISABLED
  isDefault    Boolean  @default(false)
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("AgentCreatedBy", fields: [createdById], references: [id])

  @@index([workspaceId, companyId, status])
}

// Phase 2 — Universal service catalogue. A service is what a company sells or
// AZMIN delivers. workspace-scoped; companyId is optional (null = a shared
// catalogue item; set = a specific company's offering). Prices are stored in
// minor currency units to avoid float rounding; null price = quote/custom.
model Service {
  id           String   @id @default(cuid())
  workspaceId  String
  companyId    String?
  name         String
  category     String
  description  String?
  pricingModel String   @default("PROJECT") // FIXED | HOURLY | RETAINER | PROJECT | CUSTOM
  priceCents   Int?
  currency     String   @default("AED")
  unit         String? // e.g. "per month", "per project"
  status       String   @default("ACTIVE") // ACTIVE | ARCHIVED
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdBy User?     @relation("ServiceCreatedBy", fields: [createdById], references: [id])
  leads     Lead[]

  @@index([workspaceId, status])
  @@index([workspaceId, companyId])
}

// An external channel the workspace can send through (Meta, WhatsApp, Email,
// etc.). Secrets are encrypted with the app master key like the API vault and
// never returned raw. `meta` holds non-secret display info (page name, from
// address). channel: META_PAGE | INSTAGRAM | WHATSAPP | EMAIL | TELEGRAM | WEBHOOK
model ChannelConnection {
  id              String   @id @default(cuid())
  workspaceId     String
  companyId       String?
  channel         String
  displayName     String
  status          String   @default("CONNECTED") // CONNECTED | DISABLED | ERROR
  encryptedConfig String?
  iv              String?
  authTag         String?
  keyVersion      Int      @default(1)
  meta            String? // non-secret JSON for display
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  automations Automation[]
  postTargets PostTarget[]

  @@index([workspaceId, companyId])
}

// A simple automation recipe: when `trigger` happens, run `action` (often
// through a ChannelConnection) using `template`. Kept deliberately flat so the
// UI can present it as one plain-English sentence a non-technical user edits.
// trigger: LEAD_CREATED | CONTENT_APPROVED | CONTENT_PUBLISHED | MANUAL
// action:  SEND_WHATSAPP | SEND_EMAIL | POST_META | NOTIFY | WEBHOOK
model Automation {
  id           String   @id @default(cuid())
  workspaceId  String
  companyId    String?
  name         String
  trigger      String
  action       String
  connectionId String?
  template     String? // message body with {{placeholders}}
  config       String? // JSON extras (subject, url…)
  enabled      Boolean  @default(true)
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace  Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company    Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)
  connection ChannelConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  runs       AutomationRun[]

  @@index([workspaceId, trigger, enabled])
}

// Phase 2 — a sales lead moving through the pipeline. Creating a lead fires the
// LEAD_CREATED automation trigger. `score`/`aiSummary` hold the AI/heuristic
// qualification. stage: NEW | QUALIFIED | PROPOSAL | WON | LOST
model Lead {
  id            String   @id @default(cuid())
  workspaceId   String
  companyId     String?
  serviceId     String?
  partnershipId String?
  name          String
  email         String?
  phone         String?
  source        String?
  stage         String   @default("NEW")
  valueCents    Int?
  currency      String   @default("AED")
  notes         String?
  score         Int?
  aiSummary     String?
  // Set when the lead is marked WON and converted (fires the win→bill flow once).
  clientId      String? // Client created/linked from this lead
  workId        String? // Work Order created for this lead
  wonAt         DateTime?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company     Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  service     Service?            @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  partnership Partnership?        @relation(fields: [partnershipId], references: [id], onDelete: SetNull)
  payments    CommissionPayment[]

  @@index([workspaceId, stage])
  @@index([workspaceId, companyId])
}

// Phase 8-style multi-platform publishing. Write a post once; it fans out to
// one PostTarget per connected channel. status: DRAFT | SCHEDULED | PUBLISHED |
// PARTIAL | FAILED
model SocialPost {
  id            String    @id @default(cuid())
  workspaceId   String
  companyId     String?
  content       String
  imageUrl      String?
  mediaPublicId String? // Cloudinary public id — source for per-platform variants
  mediaType     String? // image | video
  status        String    @default("DRAFT")
  scheduledAt   DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company   Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  targets   PostTarget[]

  @@index([workspaceId, status])
  @@index([workspaceId, scheduledAt])
}

// One platform destination for a SocialPost. status: PENDING | PUBLISHED |
// SIMULATED | FAILED | SKIPPED
model PostTarget {
  id           String    @id @default(cuid())
  postId       String
  connectionId String?
  channel      String
  status       String    @default("PENDING")
  detail       String?
  externalId   String?
  publishedAt  DateTime?

  post       SocialPost         @relation(fields: [postId], references: [id], onDelete: Cascade)
  connection ChannelConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([postId])
}

// Unified inbox — one Conversation per contact per channel. Incoming messages
// (WhatsApp / Messenger / Instagram DM) arrive via the Meta webhook; replies go
// out through the channel adapter. channel: WHATSAPP | MESSENGER | INSTAGRAM
// status: OPEN | CLOSED
model Conversation {
  id                 String   @id @default(cuid())
  workspaceId        String
  companyId          String?
  channel            String
  externalId         String // sender/thread id from the provider
  contactName        String?
  contactHandle      String? // phone / PSID / IG id
  status             String   @default("OPEN")
  unread             Int      @default(0)
  lastMessageAt      DateTime @default(now())
  lastMessagePreview String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  messages  Message[]

  @@unique([workspaceId, channel, externalId])
  @@index([workspaceId, status, lastMessageAt])
}

// One message in a Conversation. direction: IN | OUT. status (OUT only): SENT | FAILED
model Message {
  id             String   @id @default(cuid())
  conversationId String
  workspaceId    String
  direction      String
  body           String
  externalId     String?
  status         String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// A commission agreement with a partner company. Percentage rate is stored in
// basis points (1000 = 10%) to stay integer-exact; FLAT uses commissionFlatCents.
model Partnership {
  id                  String   @id @default(cuid())
  workspaceId         String
  partnerCompanyId    String
  name                String?
  commissionType      String   @default("PERCENT") // PERCENT | FLAT
  commissionRateBps   Int      @default(1000)
  commissionFlatCents Int?
  currency            String   @default("AED")
  notes               String?
  status              String   @default("ACTIVE") // ACTIVE | ENDED
  createdById         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  partnerCompany Company             @relation("PartnerOf", fields: [partnerCompanyId], references: [id], onDelete: Cascade)
  leads          Lead[]
  payments       CommissionPayment[]

  @@index([workspaceId, status])
}

// A recorded commission settlement (often partial) against a partnership.
model CommissionPayment {
  id            String   @id @default(cuid())
  workspaceId   String
  partnershipId String
  leadId        String?
  amountCents   Int
  currency      String   @default("AED")
  note          String?
  paidAt        DateTime @default(now())
  createdById   String?
  createdAt     DateTime @default(now())

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  partnership Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  lead        Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([workspaceId, partnershipId])
}

// One execution record for an automation. status: SUCCESS | FAILED | SIMULATED | SKIPPED
model AutomationRun {
  id           String   @id @default(cuid())
  automationId String
  workspaceId  String
  status       String
  detail       String?
  createdAt    DateTime @default(now())

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId, createdAt])
}

// Immutable audit trail of who did what. Actor fields are denormalized so an
// entry stays readable even after the actor/target is deleted (no FK).
model ActivityLog {
  id               String   @id @default(cuid())
  workspaceId      String
  actorId          String
  actorName        String
  actorAvatarColor String
  action           String // e.g. "asset.created" (validated in src/lib/activity.ts)
  category         String // content | account | creator | platform
  targetType       String?
  targetId         String?
  targetLabel      String?
  metadata         String? // JSON
  createdAt        DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

// In-app notification (bell). Delivered to a single recipient user. Actor +
// target fields are denormalized (like ActivityLog) and `message` is a pre-
// rendered summary so the bell dropdown renders without extra lookups.
model Notification {
  id               String    @id @default(cuid())
  workspaceId      String
  recipientId      String
  actorId          String
  actorName        String
  actorAvatarColor String
  action           String // e.g. "asset.approved" | "asset.reworked" | "asset.published"
  targetType       String?
  targetId         String?
  targetLabel      String?
  message          String // pre-rendered, e.g. "approved “Launch teaser”"
  readAt           DateTime?
  createdAt        DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recipient User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt, createdAt])
}

// role: OWNER | ADMIN | EDITOR | VIEWER  (validated in app)
model Membership {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  role        String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model Skill {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  systemPrompt String
  updatedById  String?
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  updatedBy User?     @relation(fields: [updatedById], references: [id])
}

// A creator/company person. May link to a login User, or stand alone.
model Person {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  email       String?
  label       String?
  userId      String?
  avatarColor String    @default("#0e9f8f")
  createdAt   DateTime  @default(now())
  // Soft-delete: archived creators disappear from pickers/filters but stay
  // referenced by past assets (attribution history is preserved).
  deletedAt   DateTime?

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?        @relation(fields: [userId], references: [id])
  assets    MediaAsset[]
}

model SocialChannel {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  icon        String
  color       String   @default("#0e9f8f")
  createdAt   DateTime @default(now())

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assets    AssetChannel[]
}

// type: IMAGE | THUMBNAIL | VIDEO | BLOGPOST | VIDEO_SCRIPT
// source: UPLOAD | GENERATED
model MediaAsset {
  id            String    @id @default(cuid())
  workspaceId   String
  personId      String
  createdById   String
  type          String
  title         String
  filename      String?
  url           String?
  thumbnailUrl  String?
  mimeType      String?
  sizeBytes     Int?
  html          String?
  tags          String    @default("[]") // JSON string[]
  note          String? // free-text note (e.g. describing an "Other"-category asset)
  source        String
  chatMessageId String?
  status        String    @default("PENDING") // PENDING | REWORK | APPROVED | PUBLISHED
  reviewNote    String? // admin's rework comment
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  deletedAt     DateTime?

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  person    Person         @relation(fields: [personId], references: [id])
  createdBy User           @relation("AssetCreatedBy", fields: [createdById], references: [id])
  message   ChatMessage?   @relation(fields: [chatMessageId], references: [id])
  channels  AssetChannel[]
  versions  AssetVersion[]
}

model AssetChannel {
  assetId      String
  channelId    String
  scheduledFor DateTime? // planned post date for this asset on this platform

  asset   MediaAsset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  channel SocialChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([assetId, channelId])
}

model AssetVersion {
  id           String   @id @default(cuid())
  assetId      String
  snapshotJson String // JSON snapshot of the asset before an edit
  editedById   String
  createdAt    DateTime @default(now())

  asset    MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  editedBy User       @relation(fields: [editedById], references: [id])
}

model ChatSession {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  title       String
  createdAt   DateTime  @default(now())
  archivedAt  DateTime?

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
}

// role: user | assistant  (validated in app)
model ChatMessage {
  id           String   @id @default(cuid())
  sessionId    String
  role         String
  content      String
  attachments  String   @default("[]") // JSON string[]
  artifactJson String? // JSON artifact payload
  createdAt    DateTime @default(now())

  session ChatSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  assets  MediaAsset[]
}

model Invite {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  role        String
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// PHASE 6: INFRASTRUCTURE & AZMIN PULSE
// ==========================================

model DomainRecord {
  id          String    @id @default(cuid())
  workspaceId String
  companyId   String?
  domainName  String
  registrar   String?
  expiryDate  DateTime?
  autoRenew   Boolean   @default(false)
  status      String    @default("ACTIVE") // ACTIVE | EXPIRED | TRANSFERRING
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([workspaceId, companyId])
}

model HostingRecord {
  id          String    @id @default(cuid())
  workspaceId String
  companyId   String?
  provider    String // e.g., "Coolify", "Vercel", "Hetzner"
  planDetails String?
  serverUuid  String? // For Coolify integration sync
  renewalDate DateTime?
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([workspaceId, companyId])
}

model EmailServiceRecord {
  id          String    @id @default(cuid())
  workspaceId String
  companyId   String?
  provider    String // e.g. "Google Workspace", "Microsoft 365"
  seats       Int       @default(1)
  renewalDate DateTime?
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([workspaceId, companyId])
}

model PulseSubscription {
  id              String    @id @default(cuid())
  workspaceId     String
  companyId       String?
  planName        String
  status          String    @default("ACTIVE") // ACTIVE | CANCELED | PAST_DUE
  nextBillingDate DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([workspaceId, companyId])
}

// Phase 5 — Development Studio. A DevProject is a build/software effort for a
// company (or internal). Repositories hang off it; branch tracking is a JSON
// string[] on the repository (see dev-studio-catalog). Soft-deleted.
model DevProject {
  id            String    @id @default(cuid())
  workspaceId   String
  companyId     String?
  createdById   String?
  name          String
  description   String?
  status        String    @default("ACTIVE") // PLANNING | ACTIVE | MAINTENANCE | ARCHIVED
  productionUrl String?
  order         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  repositories Repository[]

  @@index([workspaceId, companyId])
  @@index([workspaceId, status])
}

// A source repository tracked under a DevProject. defaultBranch is the primary
// branch; branches is a JSON string[] of extra tracked branch names.
model Repository {
  id            String   @id @default(cuid())
  workspaceId   String
  devProjectId  String
  provider      String   @default("github") // github | gitlab | bitbucket | other
  fullName      String // owner/repo
  url           String
  defaultBranch String   @default("main")
  branches      String   @default("[]") // JSON string[]
  visibility    String   @default("private") // private | public
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  devProject DevProject @relation(fields: [devProjectId], references: [id], onDelete: Cascade)

  @@index([workspaceId, devProjectId])
}
