// MediaChat — Prisma schema (see CLAUDE.md "Prisma model")
//
// Runs on PostgreSQL (Neon). For portability the schema keeps a couple of
// deliberate simplifications that also worked on the original SQLite dev DB:
//   - enum-like fields (role, asset type, source, chat role) are stored as
//     String and validated in application code (see src/lib/enums.ts).
//   - JSON-ish fields (tags, attachments, snapshots, artifacts) are stored as
//     String holding JSON — use the helpers in src/lib/json.ts to (de)serialize.
//   - the asset<->channel many-to-many uses the explicit AssetChannel join
//     table (already required by the spec) instead of an array column.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  passwordHash      String
  avatarColor       String    @default("#0e9f8f")
  createdAt         DateTime  @default(now())
  // Bumped on password reset/change to invalidate older JWT sessions.
  passwordChangedAt DateTime  @default(now())
  // Set when an admin deactivates the account — login + active sessions blocked.
  disabledAt        DateTime?

  memberships   Membership[]
  person        Person[]
  createdAssets MediaAsset[]         @relation("AssetCreatedBy")
  assetVersions AssetVersion[]
  chatSessions  ChatSession[]
  skillUpdates  Skill[]
  resetTokens   PasswordResetToken[]
  notifications Notification[]
  agentProfiles AgentProfile[]       @relation("AgentCreatedBy")
  services      Service[]            @relation("ServiceCreatedBy")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  memberships         Membership[]
  skills              Skill[]
  people              Person[]
  channels            SocialChannel[]
  assets              MediaAsset[]
  sessions            ChatSession[]
  invites             Invite[]
  activity            ActivityLog[]
  notifications       Notification[]
  companies           Company[]
  providerCredentials ProviderCredential[]
  agentProfiles       AgentProfile[]
  services            Service[]
}

// Workspace-scoped API credential. The raw secret is encrypted by the app with
// an environment-held master key and is never returned to the browser.
model ProviderCredential {
  id              String    @id @default(cuid())
  workspaceId     String
  provider        String
  encryptedValue  String
  iv              String
  authTag         String
  keyVersion      Int       @default(1)
  maskedValue     String
  status          String    @default("ACTIVE")
  lastTestedAt    DateTime?
  lastTestStatus  String?
  lastTestMessage String?
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
  @@index([workspaceId, status])
}

// A separately managed business identity inside one tenant/workspace.
// relationshipType: OWN_BRAND | CLIENT | PARTNER | JOINT_VENTURE
// status: ACTIVE | PAUSED | ARCHIVED
model Company {
  id               String   @id @default(cuid())
  workspaceId      String
  name             String
  slug             String
  relationshipType String
  industry         String?
  website          String?
  description      String?
  status           String   @default("ACTIVE")
  isHeadquarters   Boolean  @default(false)
  primaryColor     String   @default("#087CFA")
  accentColor      String   @default("#22D3EE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brandProfile BrandProfile?
  brain        CompanyBrain?
  agents       AgentProfile[]
  services     Service[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, status])
}

model BrandProfile {
  id              String   @id @default(cuid())
  companyId       String   @unique
  tagline         String?
  brandVoice      String?
  targetAudiences String   @default("[]")
  offerings       String   @default("[]")
  differentiators String   @default("[]")
  contentRules    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model CompanyBrain {
  id              String   @id @default(cuid())
  companyId       String   @unique
  companyFacts    String?
  salesGuidance   String?
  contentGuidance String?
  aiInstructions  String?
  knowledgeStatus String   @default("EMPTY")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// A named, company-scoped AI operator. Its effective runtime system prompt is
// composed from the company Brand Profile + Company Brain + this profile's own
// instructions (see src/lib/agents.ts), so an agent can never carry another
// company's context. `autonomy` is the automation dial: how far it may act
// before a human approves (SUGGEST | DRAFT | AUTOPILOT).
model AgentProfile {
  id           String   @id @default(cuid())
  workspaceId  String
  companyId    String
  name         String
  role         String
  systemPrompt String
  providerId   String? // preferred vault provider (ProviderCredential.provider); null -> router default
  autonomy     String   @default("SUGGEST") // SUGGEST | DRAFT | AUTOPILOT
  status       String   @default("ACTIVE") // ACTIVE | DISABLED
  isDefault    Boolean  @default(false)
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("AgentCreatedBy", fields: [createdById], references: [id])

  @@index([workspaceId, companyId, status])
}

// Phase 2 — Universal service catalogue. A service is what a company sells or
// AZMIN delivers. workspace-scoped; companyId is optional (null = a shared
// catalogue item; set = a specific company's offering). Prices are stored in
// minor currency units to avoid float rounding; null price = quote/custom.
model Service {
  id           String   @id @default(cuid())
  workspaceId  String
  companyId    String?
  name         String
  category     String
  description  String?
  pricingModel String   @default("PROJECT") // FIXED | HOURLY | RETAINER | PROJECT | CUSTOM
  priceCents   Int?
  currency     String   @default("AED")
  unit         String? // e.g. "per month", "per project"
  status       String   @default("ACTIVE") // ACTIVE | ARCHIVED
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdBy User?     @relation("ServiceCreatedBy", fields: [createdById], references: [id])

  @@index([workspaceId, status])
  @@index([workspaceId, companyId])
}

// Immutable audit trail of who did what. Actor fields are denormalized so an
// entry stays readable even after the actor/target is deleted (no FK).
model ActivityLog {
  id               String   @id @default(cuid())
  workspaceId      String
  actorId          String
  actorName        String
  actorAvatarColor String
  action           String // e.g. "asset.created" (validated in src/lib/activity.ts)
  category         String // content | account | creator | platform
  targetType       String?
  targetId         String?
  targetLabel      String?
  metadata         String? // JSON
  createdAt        DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

// In-app notification (bell). Delivered to a single recipient user. Actor +
// target fields are denormalized (like ActivityLog) and `message` is a pre-
// rendered summary so the bell dropdown renders without extra lookups.
model Notification {
  id               String    @id @default(cuid())
  workspaceId      String
  recipientId      String
  actorId          String
  actorName        String
  actorAvatarColor String
  action           String // e.g. "asset.approved" | "asset.reworked" | "asset.published"
  targetType       String?
  targetId         String?
  targetLabel      String?
  message          String // pre-rendered, e.g. "approved “Launch teaser”"
  readAt           DateTime?
  createdAt        DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recipient User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt, createdAt])
}

// role: OWNER | ADMIN | EDITOR | VIEWER  (validated in app)
model Membership {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  role        String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model Skill {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  systemPrompt String
  updatedById  String?
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  updatedBy User?     @relation(fields: [updatedById], references: [id])
}

// A creator/company person. May link to a login User, or stand alone.
model Person {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  email       String?
  label       String?
  userId      String?
  avatarColor String    @default("#0e9f8f")
  createdAt   DateTime  @default(now())
  // Soft-delete: archived creators disappear from pickers/filters but stay
  // referenced by past assets (attribution history is preserved).
  deletedAt   DateTime?

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?        @relation(fields: [userId], references: [id])
  assets    MediaAsset[]
}

model SocialChannel {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  icon        String
  color       String   @default("#0e9f8f")
  createdAt   DateTime @default(now())

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assets    AssetChannel[]
}

// type: IMAGE | THUMBNAIL | VIDEO | BLOGPOST | VIDEO_SCRIPT
// source: UPLOAD | GENERATED
model MediaAsset {
  id            String    @id @default(cuid())
  workspaceId   String
  personId      String
  createdById   String
  type          String
  title         String
  filename      String?
  url           String?
  thumbnailUrl  String?
  mimeType      String?
  sizeBytes     Int?
  html          String?
  tags          String    @default("[]") // JSON string[]
  note          String? // free-text note (e.g. describing an "Other"-category asset)
  source        String
  chatMessageId String?
  status        String    @default("PENDING") // PENDING | REWORK | APPROVED | PUBLISHED
  reviewNote    String? // admin's rework comment
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  deletedAt     DateTime?

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  person    Person         @relation(fields: [personId], references: [id])
  createdBy User           @relation("AssetCreatedBy", fields: [createdById], references: [id])
  message   ChatMessage?   @relation(fields: [chatMessageId], references: [id])
  channels  AssetChannel[]
  versions  AssetVersion[]
}

model AssetChannel {
  assetId      String
  channelId    String
  scheduledFor DateTime? // planned post date for this asset on this platform

  asset   MediaAsset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  channel SocialChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([assetId, channelId])
}

model AssetVersion {
  id           String   @id @default(cuid())
  assetId      String
  snapshotJson String // JSON snapshot of the asset before an edit
  editedById   String
  createdAt    DateTime @default(now())

  asset    MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  editedBy User       @relation(fields: [editedById], references: [id])
}

model ChatSession {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  title       String
  createdAt   DateTime  @default(now())
  archivedAt  DateTime?

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
}

// role: user | assistant  (validated in app)
model ChatMessage {
  id           String   @id @default(cuid())
  sessionId    String
  role         String
  content      String
  attachments  String   @default("[]") // JSON string[]
  artifactJson String? // JSON artifact payload
  createdAt    DateTime @default(now())

  session ChatSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  assets  MediaAsset[]
}

model Invite {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  role        String
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
